# Environment and secrets
# Every .env variant is ignored. The base CLAUDE.md permits .env for non-secret
# local config, which is exactly how a credential ends up in one.
.env
.env.*
!.env.example
!.env.sample

# Claude Code local settings
.claude/settings.local.json

# Dependencies
node_modules/

# OS files
.DS_Store
Thumbs.db

# Keys and certificates
*.pem
*.key
*.p12
*.pfx
